# Copy to .dev.vars for local wrangler dev. Never commit .dev.vars.

AZURE_API_KEY=

# Supabase project URL (same as EXPO_PUBLIC_SUPABASE_URL). Required for JWKS
# verification of ECC/RS256 user access tokens.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional HS256 fallback (legacy JWT secret). Not required when the project
# uses JWT Signing Keys (ECC/RSA) and JWKS verification.
SUPABASE_JWT_SECRET=

# Comma-separated browser origins, or * for any (fine for native / local).
CORS_ORIGINS=*
